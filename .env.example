# P.A.C.O. server settings. Copy to .env and fill in. Never share .env.

# Which AI answers: deepseek or claude.
BRAIN_PROVIDER=deepseek

# DeepSeek (https://platform.deepseek.com/). Thinking off = faster replies.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=off

# Claude (https://console.anthropic.com/) - only needed when BRAIN_PROVIDER=claude.
ANTHROPIC_API_KEY=

# Shared secret PACO uses to connect. Must match PACO_TOKEN in the firmware's secrets.h.
PACO_TOKEN=

# Password for the web dashboard (http://<server>:<port>/).
DASHBOARD_PASSWORD=

# Port the server listens on. Forward this port on your router.
PORT=8765

# Speech model: tiny, base, small, medium (add .en for English-only, more accurate). Bigger = slower.
WHISPER_MODEL=small.en
# Smaller, faster model for the live words shown while you talk.
WHISPER_LIVE_MODEL=base.en

# Force a speech language (e.g. en, uk, lv, ru) or leave empty to auto-detect.
WHISPER_LANGUAGE=en

# Claude model and effort (when BRAIN_PROVIDER=claude). low effort keeps replies fast.
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low

# Digital boost for the quiet analog mic before speech detection (1 = off).
MIC_BOOST=4

# PACO only answers speech starting with this name ("PACO, what time is it?").
# Set to off to answer everything it hears.
WAKE_WORD=paco
